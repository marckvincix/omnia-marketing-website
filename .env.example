# Connessione pooled (pgbouncer, transaction mode) - usata a runtime dall'app
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Connessione diretta (no pooler) - usata dalla CLI Prisma per le migrazioni
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth (M3) - genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Supabase Storage (Media Library, M6)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Stessi valori sopra, esposti al browser: servono per caricare i file direttamente
# su Supabase Storage con URL firmati, bypassando il limite di 4.5MB delle
# Serverless Function di Vercel. La publishable key è pensata per essere pubblica.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Sync articoli da Omnia Hub (progetto Supabase separato, sola lettura content_updates pubblicati)
HUB_SUPABASE_URL=""
HUB_SUPABASE_ANON_KEY=""

# Protegge l'endpoint /api/cron/sync-blog dalle chiamate non autorizzate
CRON_SECRET=""

# Invio email newsletter (Resend) - il dominio nel from deve essere verificato su resend.com/domains
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Omnia Marketing <info@sito.omniamarketing.it>"

# Firma dei webhook Resend (Dashboard Resend → Webhooks → segreto endpoint, whsec_...)
RESEND_WEBHOOK_SECRET=""
