// Prisma schema — Omnia Marketing website
// Vedi knowledge-base/00-KNOWLEDGE-BASE-SITO-ATTUALE.md per il contesto dei contenuti

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AdminRole {
  ADMIN
  EDITOR
}

// --- Auth --------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// --- Impostazioni sito / Homepage --------------------------------------

model SiteSettings {
  id                 Int      @id @default(1)
  heroTitle          String
  heroSubtitle       String?
  heroCtaLabel       String?
  heroCtaUrl         String?
  heroMediaUrl       String?
  companyName        String
  piva               String
  legalAddress       String
  operationalAddress String
  contactEmail       String
  contactPhone       String?
  footerText         String?
  clientsAreaUrl      String   @default("https://hub.omniamarketing.it")
  updatedAt          DateTime @updatedAt
}

// Singleton per lingua (non ha una riga SiteSettings a cui collegarsi con una FK: la
// riga id=1 è unica, quindi qui basta la lingua come chiave). Tradotta automaticamente
// da DeepL a ogni salvataggio delle impostazioni in admin.
model SiteSettingsTranslation {
  id           String   @id @default(cuid())
  locale       String   @unique
  heroTitle    String
  heroSubtitle String?
  heroCtaLabel String?
  footerText   String?
  updatedAt    DateTime @updatedAt
}

model SocialLink {
  id       String @id @default(cuid())
  platform String // instagram | linkedin | facebook | tiktok | youtube ...
  url      String
  order    Int    @default(0)
}

model Stat {
  id     String @id @default(cuid())
  label  String
  value  String
  order  Int    @default(0)
}

model ClientLogo {
  id        String  @id @default(cuid())
  name      String
  logoUrl   String
  url       String?
  order     Int     @default(0)
  published Boolean @default(true)
}

// --- Servizi -------------------------------------------------------------

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  description String
  heroImage   String?
  heroVideo   String?
  ctaLabel    String   @default("Contattaci")
  ctaUrl      String   @default("/contatti")
  order       Int      @default(0)
  published   Boolean  @default(true)

  seoTitle       String?
  seoDescription String?
  ogImage        String?

  benefits           ServiceBenefit[]
  faqs               Faq[]
  projects           ProjectService[]
  contactSubmissions ContactSubmission[]
  translations       ServiceTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Traduzione automatica (DeepL) dei soli campi di testo di un Service, generata dopo
// ogni salvataggio in admin. Se manca per una lingua (traduzione in corso o quota DeepL
// esaurita) il sito pubblico ricade sui campi italiani del Service, campo per campo.
model ServiceTranslation {
  id             String   @id @default(cuid())
  serviceId      String
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  locale         String
  title          String
  excerpt        String
  description    String
  ctaLabel       String?
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt

  @@unique([serviceId, locale])
}

model ServiceBenefit {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  description String
  icon        String?
  order       Int     @default(0)

  translations ServiceBenefitTranslation[]
}

model ServiceBenefitTranslation {
  id               String         @id @default(cuid())
  serviceBenefitId String
  serviceBenefit   ServiceBenefit @relation(fields: [serviceBenefitId], references: [id], onDelete: Cascade)
  locale           String
  title            String
  description      String
  updatedAt        DateTime       @updatedAt

  @@unique([serviceBenefitId, locale])
}

// --- Portfolio -------------------------------------------------------------

model Project {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  client      String
  description String
  category    String[] @default([])
  year        Int?
  externalUrl String?

  // Testo esteso per la pagina progetto: spiega il processo/approccio tecnico del lavoro svolto.
  processText String?

  resultsText        String?
  testimonialAuthor   String?
  testimonialRole     String?
  testimonialQuote    String?

  order     Int     @default(0)
  published Boolean @default(true)

  // Immagine di copertina: sfondo mostrato in ogni scheda progetto sul sito.
  coverImage String?

  seoTitle       String?
  seoDescription String?
  ogImage        String?

  // Testo pensato per i motori generativi/AI (GEO), distinto dalla meta description SEO tradizionale.
  geoTitle       String?
  geoDescription String?

  // Parola/frase chiave principale su cui è ottimizzata la pagina: usata dall'analizzatore
  // SEO in admin (stile Yoast) per calcolare punteggio e checklist, non mostrata sul sito.
  focusKeyword String?

  media       ProjectMedia[]
  services    ProjectService[]
  testimonials Testimonial[]
  translations ProjectTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Stesso pattern di ServiceTranslation: solo i campi di testo, mai slug/url/anno/categoria.
model ProjectTranslation {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locale           String
  title            String
  description      String
  processText      String?
  resultsText      String?
  testimonialAuthor String?
  testimonialRole   String?
  testimonialQuote  String?
  seoTitle         String?
  seoDescription   String?
  geoTitle         String?
  geoDescription   String?
  updatedAt        DateTime @updatedAt

  @@unique([projectId, locale])
}

model ProjectMedia {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType @default(IMAGE)
  alt       String
  order     Int       @default(0)
}

// join esplicito Project <-> Service ("servizi svolti" per progetto)
model ProjectService {
  projectId String
  serviceId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
}

// --- Testimonianze / FAQ / Team --------------------------------------------

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  authorRole String?
  company    String?
  quote      String
  avatarUrl  String?
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  translations TestimonialTranslation[]
}

// authorName e company non sono tradotti: sono nomi propri (persona/azienda), non testo
// da tradurre. Solo la citazione e il ruolo (es. "Fondatore", "Direttore Marketing").
model TestimonialTranslation {
  id            String      @id @default(cuid())
  testimonialId String
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  locale        String
  quote         String
  authorRole    String?
  updatedAt     DateTime    @updatedAt

  @@unique([testimonialId, locale])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  order     Int      @default(0)
  published Boolean  @default(true)

  translations FaqTranslation[]
}

model FaqTranslation {
  id        String   @id @default(cuid())
  faqId     String
  faq       Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)
  locale    String
  question  String
  answer    String
  updatedAt DateTime @updatedAt

  @@unique([faqId, locale])
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  role        String
  bio         String?
  photoUrl    String?
  linkedinUrl String?
  order       Int     @default(0)
  published   Boolean @default(true)

  posts BlogPost[]
  translations TeamMemberTranslation[]
}

// name non è tradotto: è il nome di una persona, non testo.
model TeamMemberTranslation {
  id           String     @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  locale       String
  role         String
  bio          String?
  updatedAt    DateTime   @updatedAt

  @@unique([teamMemberId, locale])
}

// --- Blog --------------------------------------------------------------

model BlogCategory {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  posts     BlogPost[]
  interests SubscriberInterest[]
}

model BlogTag {
  id    String       @id @default(cuid())
  name  String
  slug  String       @unique
  posts BlogPostTag[]
}

model BlogPost {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  excerpt String
  content String

  // Id della riga sorgente in Omnia Hub (content_updates), per la sync automatica.
  externalId String? @unique

  coverImage        String?
  categoryId         String?
  category           BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId           String?
  author             TeamMember?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  readingTimeMinutes Int           @default(1)

  published   Boolean   @default(false)
  publishedAt DateTime?

  // Quando è stata inviata l'email di aggiornamento agli iscritti alla newsletter.
  newsletterSentAt DateTime?

  seoTitle       String?
  seoDescription String?
  ogImage        String?

  // Parola/frase chiave principale su cui è ottimizzato l'articolo: usata dall'analizzatore
  // SEO in admin (stile Yoast) per calcolare punteggio e checklist, non mostrata sul sito.
  focusKeyword String?

  tags BlogPostTag[]
  emailCampaigns EmailCampaign[]
  translations BlogPostTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPostTranslation {
  id             String   @id @default(cuid())
  postId         String
  post           BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale         String
  title          String
  excerpt        String
  content        String
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt

  @@unique([postId, locale])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

// --- Media library -------------------------------------------------------

model Media {
  id        String    @id @default(cuid())
  url       String
  type      MediaType @default(IMAGE)
  altText   String    @default("")
  width     Int?
  height    Int?
  sizeBytes Int?
  folder    String?
  createdAt DateTime  @default(now())
}

// --- Contatti / Pagine legali ---------------------------------------------

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  handled   Boolean  @default(false)
  // Lingua del sito da cui è stato inviato il modulo: usata per rispondere nella stessa
  // lingua dall'admin (la risposta parte ore/giorni dopo, quando non c'è più una request
  // in corso da cui dedurla).
  locale    String   @default("it")
  createdAt DateTime @default(now())
}

// Nome lasciato nel popup di benvenuto, salvato solo se il visitatore ha accettato
// la personalizzazione nel banner cookie. visitorId collega il record allo stesso
// profilo anonimo del tracciamento interessi, per evitare duplicati a ogni riapertura
// del popup ed essere cancellabile insieme al resto quando revoca il consenso.
model VisitorName {
  id        String   @id @default(cuid())
  name      String
  visitorId String?  @unique
  // Slug del servizio ("web" | "branding" | "social") con più interazioni per questo
  // visitatore. Aggiornato ogni volta che naviga, quindi resta valido anche appena dopo
  // aver lasciato il nome, non solo dopo i giorni necessari a diventare "visitatore di ritorno".
  topInterest String?
  // Città dedotta dall'header di geolocalizzazione di Vercel (edge network) al momento
  // dell'invio del nome: nessun indirizzo IP viene mai letto né salvato, solo la città
  // che Vercel calcola per noi.
  city        String?
  // Da dove arriva il visitatore alla prima visita in assoluto (referrer/UTM), calcolato
  // una sola volta al momento del consenso e mai più ricalcolato nelle visite successive,
  // altrimenti la navigazione interna al sito lo sovrascriverebbe.
  trafficSource String?
  // Segnali grezzi per il punteggio lead, aggiornati ad ogni pagina/interazione tracciata:
  // il punteggio vero e proprio si calcola in base a questi, non è salvato qui, per poter
  // affinare l'algoritmo senza dover rimigrare i dati.
  visitCount    Int     @default(1)
  tier          Int     @default(0)
  interestScore Int     @default(0)
  contacted     Boolean @default(false)
  createdAt DateTime @default(now())
}

// Nota: non collegato a nessuna pagina pubblica — privacy-policy e cookie-policy sono
// testo JSX scritto direttamente nelle rispettive pagine, non contenuto da qui. Modello
// tenuto per compatibilità con dati/migrazioni preesistenti, ma senza tabella di
// traduzione: le pagine legali restano solo in italiano finché non verranno collegate a
// un contenuto reale da tradurre (e in quel caso meritano revisione umana, non solo DeepL).
model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique // "privacy-policy" | "cookie-policy"
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

// --- Newsletter ------------------------------------------------------------

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  // Valorizzato solo per gli iscritti aggiunti tramite import CSV/XLS da admin (il form di
  // iscrizione pubblico non chiede il nome): opzionale, mai bloccante.
  name             String?
  unsubscribeToken String    @unique @default(cuid())
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?
  // Se chi si iscrive ha anche accettato la personalizzazione e ha un profilo anonimo
  // attivo, colleghiamo l'iscrizione a quel visitorId: permette di mostrare l'email in
  // /admin/visitatori quando la stessa persona ha lasciato anche il nome.
  visitorId        String?
  // Lingua del sito selezionata al momento dell'iscrizione (dal selettore nel dock):
  // le email operative (newsletter, risposte) arrivano in questa lingua.
  locale           String    @default("it")

  emailEvents EmailEvent[]
  interests   SubscriberInterest[]
}

// Quante volte un iscritto ha cliccato un link in una newsletter il cui articolo apparteneva
// a una data categoria (Web/Branding/Social): permette di capire di cosa si interessa
// davvero e di segmentare i prossimi invii di conseguenza, invece di mandare a tutti lo
// stesso contenuto. Aggiornato dal webhook Resend (email.clicked) e dal fallback di sync.
model SubscriberInterest {
  id            String   @id @default(cuid())
  subscriberId  String
  subscriber    NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  categoryId    String
  category      BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  clickCount    Int      @default(0)
  lastClickedAt DateTime @default(now())

  @@unique([subscriberId, categoryId])
}

// --- Email marketing -------------------------------------------------------

enum EmailEventStatus {
  SENT
  DELIVERED
  DELIVERY_DELAYED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
}

model EmailCampaign {
  id              String    @id @default(cuid())
  subject         String
  blogPostId      String?
  blogPost        BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: SetNull)
  sentAt          DateTime  @default(now())
  totalRecipients Int       @default(0)

  events EmailEvent[]
}

model EmailEvent {
  id             String           @id @default(cuid())
  campaignId     String
  campaign       EmailCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId   String
  subscriber     NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  resendEmailId  String           @unique
  status         EmailEventStatus @default(SENT)

  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([subscriberId])
}

// Traccia ogni email inviata dal sito tramite Resend (newsletter, benvenuto, conferme di
// contatto, risposte admin — qualunque chiamata a resend.emails.send), a differenza di
// EmailEvent che segue solo gli invii di newsletter. Serve esclusivamente a calcolare in
// admin/newsletter quanto del limite "Transactional" del piano Resend (giornaliero e
// mensile) è già stato consumato: Resend non espone questo dato tramite API pubblica, solo
// nella propria dashboard, quindi lo stimiamo qui con un conteggio interno.
model EmailSendLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  @@index([createdAt])
}
